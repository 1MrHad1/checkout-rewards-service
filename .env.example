# Copy to .env if you want to override anything. Every value has a working
# default, so the service runs without this file.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/checkout_dev
PORT=3000

# Reward policy: a coupon for REWARD_PERCENT_OFF becomes available after every
# REWARD_ORDER_INTERVAL-th placed order.
REWARD_ORDER_INTERVAL=5
REWARD_PERCENT_OFF=10

CURRENCY=INR
